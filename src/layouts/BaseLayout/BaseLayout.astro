---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/epilogue';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/main.scss';
import './BaseLayout.scss';
import SocialMeta from '@/components/layout/SocialMeta/SocialMeta.astro';
import StructuredData from '@/components/layout/StructuredData/StructuredData.astro';
import {
  DEFAULT_LOCALE,
  getDictionary,
  LOCALE_META,
  LOCALES,
  localizePath,
  resolveLocale,
  stripLocale,
} from '@/i18n';
import { THEME_STORAGE_KEY } from '@/scripts/core/theme';

interface Props {
  title?: string;
  description?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale);
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const path = stripLocale(Astro.url.pathname);
const canonical = new URL(localizePath(locale, path), Astro.site);
const alternates = LOCALES.map((alt) => ({
  hreflang: LOCALE_META[alt].htmlLang,
  href: new URL(localizePath(alt, path), Astro.site).href,
}));
const defaultAlternate = new URL(localizePath(DEFAULT_LOCALE, path), Astro.site).href;
const ogImage = new URL(`/og/og-${locale}.png`, Astro.site).href;
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultAlternate} />

    <SocialMeta locale={locale} title={title} description={description} url={canonical.href} />

    <StructuredData locale={locale} url={canonical.href} image={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111114" />

    {/* Antes del primer pintado: tema guardado (o del sistema) y bandera de JS. */}
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      const root = document.documentElement;
      root.classList.add('js');
      let theme = null;
      try {
        theme = localStorage.getItem(storageKey);
      } catch {
        // Storage bloqueado: se usa la preferencia del sistema.
      }
      if (theme !== 'light' && theme !== 'dark') {
        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      root.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.a11y.skipToContent}
    </a>
    <slot name="overlay" />
    <slot name="header" />
    <main class="page" id="main">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
