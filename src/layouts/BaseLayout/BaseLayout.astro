---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/epilogue';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/main.scss';
import './BaseLayout.scss';
import StructuredData from '@/components/layout/StructuredData/StructuredData.astro';
import { profile } from '@/config/profile';
import {
  DEFAULT_LOCALE,
  getDictionary,
  LOCALE_META,
  LOCALES,
  localizePath,
  resolveLocale,
  stripLocale,
} from '@/i18n';
import { THEME_STORAGE_KEY } from '@/scripts/core/theme';

interface Props {
  title?: string;
  description?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale);
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const path = stripLocale(Astro.url.pathname);
const canonical = new URL(localizePath(locale, path), Astro.site);
const alternates = LOCALES.map((alt) => ({
  hreflang: LOCALE_META[alt].htmlLang,
  href: new URL(localizePath(alt, path), Astro.site).href,
}));
const defaultAlternate = new URL(localizePath(DEFAULT_LOCALE, path), Astro.site).href;
// Imagen para compartir (1200×630) por idioma; se regenera con `npm run og`.
const ogImage = new URL(`/og/og-${locale}.png`, Astro.site).href;
const otherLocales = LOCALES.filter((alt) => alt !== locale);
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultAlternate} />

    <meta name="author" content={profile.fullName} />

    {/* Vista previa al compartir (WhatsApp, LinkedIn, Slack, Facebook...). */}
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
    {otherLocales.map((alt) => (
      <meta property="og:locale:alternate" content={LOCALE_META[alt].ogLocale} />
    ))}
    <meta property="profile:first_name" content={profile.givenName} />
    <meta property="profile:last_name" content={profile.familyName} />

    {/* X (Twitter): sin twitter:card solo se muestra el enlace. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <StructuredData locale={locale} url={canonical.href} image={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111114" />

    {/* Antes del primer pintado: tema guardado (o del sistema) y bandera de JS. */}
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      const root = document.documentElement;
      root.classList.add('js');
      let theme = null;
      try {
        theme = localStorage.getItem(storageKey);
      } catch {
        // Storage bloqueado: se usa la preferencia del sistema.
      }
      if (theme !== 'light' && theme !== 'dark') {
        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      root.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.a11y.skipToContent}
    </a>
    <slot name="overlay" />
    <slot name="header" />
    <main class="page" id="main">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
