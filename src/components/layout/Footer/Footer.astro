---
import './Footer.scss';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>© {year} Jaiber Flor</p>
  <a class="site-footer__top" href="#top">
    {t.footer.backToTop} ↑
  </a>
</footer>
