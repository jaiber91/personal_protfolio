---
import './Header.scss';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher/LanguageSwitcher.astro';
import ThemeToggle from '@/components/ui/ThemeToggle/ThemeToggle.astro';
import type { Dictionary, Locale } from '@/i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;
---

<!-- Header mínimo: marca a la izquierda, idioma y tema a la derecha.
     La navegación vive en el dock inferior (ver Dock). -->
<header class="site-header">
  <a class="site-header__brand" href="#top" aria-label={t.hero.title}>
    <span class="site-header__mark">JF</span>
    <span class="site-header__name">{t.hero.title}</span>
  </a>
  <div class="site-header__status">
    <span class="site-header__pulse" aria-hidden="true"></span>
    {t.hud.status}
  </div>
  <div class="site-header__tools">
    <LanguageSwitcher current={locale} label={t.a11y.changeLanguage} />
    <ThemeToggle label={t.a11y.toggleTheme} />
  </div>
</header>
