---
// Metadatos para la vista previa al compartir (WhatsApp, LinkedIn, Slack, Facebook, X).
// Se usan en las páginas de idioma y en la raíz: los rastreadores de vista previa no
// ejecutan JavaScript, así que la raíz (que redirige por idioma) también los necesita.
import { profile } from '@/config/profile';
import { getDictionary, LOCALE_META, LOCALES, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  url: string;
}

const { locale, title, description, url } = Astro.props;
const t = getDictionary(locale);
// Imagen 1200×630 por idioma; se regenera con `npm run og`.
const image = new URL(`/og/og-${locale}.png`, Astro.site).href;
const otherLocales = LOCALES.filter((alt) => alt !== locale);
---

<meta name="author" content={profile.fullName} />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={profile.displayName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t.meta.ogImageAlt} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{otherLocales.map((alt) => (
  <meta property="og:locale:alternate" content={LOCALE_META[alt].ogLocale} />
))}
<meta property="profile:first_name" content={profile.givenName} />
<meta property="profile:last_name" content={profile.familyName} />

{/* X (Twitter): sin twitter:card solo se muestra el enlace. */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={t.meta.ogImageAlt} />
