---
import './ProjectCard.scss';
import type { ImageMetadata } from 'astro';
import DeviceFrame, { type Device } from '@/components/ui/DeviceFrame/DeviceFrame.astro';
import { createRandom } from '@/webgl/utils/random';

interface Props {
  index: number;
  total: number;
  title: string;
  summary: string;
  role: string;
  stack: string[];
  year: number;
  device: Device;
  url?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  placeholder?: boolean;
  labels: { pass: string; gate: string; year: string; role: string; stack: string; view: string };
}

const {
  index,
  total,
  title,
  summary,
  role,
  stack,
  year,
  device,
  url,
  image,
  imageAlt,
  placeholder,
  labels,
} = Astro.props;
const code = `JF${String(index).padStart(3, '0')}`;
const gates: Record<Device, string> = { phone: 'M1', tablet: 'T2', web: 'W3' };

// Código de barras decorativo, estable por proyecto.
const random = createRandom(index * 7);
const bars = Array.from({ length: 38 }, () => 1 + Math.floor(random() * 3));
---

<!-- Pase de abordar: cuerpo con la pantalla del proyecto + talón con los datos. -->
<article class:list={['ticket', { 'ticket--placeholder': placeholder }]} data-ticket>
  <div class="ticket__main">
    <p class="ticket__top">
      <span>{labels.pass}</span>
      <span>
        {code} · {String(index).padStart(2, '0')}/{String(total).padStart(2, '0')}
      </span>
    </p>
    <div class="ticket__screen">
      <DeviceFrame device={device} image={image} alt={imageAlt} />
    </div>
    <h3 class="ticket__title">{title}</h3>
    <p class="ticket__summary">{summary}</p>
  </div>

  <div class="ticket__stub">
    <dl class="ticket__data">
      <div>
        <dt>{labels.gate}</dt>
        <dd class="ticket__gate">{gates[device]}</dd>
      </div>
      <div>
        <dt>{labels.year}</dt>
        <dd>{year}</dd>
      </div>
      <div class="ticket__wide">
        <dt>{labels.role}</dt>
        <dd>{role}</dd>
      </div>
      <div class="ticket__wide">
        <dt>{labels.stack}</dt>
        <dd>{stack.join(' · ')}</dd>
      </div>
    </dl>
    <span class="ticket__barcode" aria-hidden="true">
      {bars.map((width) => (
        <span style={`--w: ${width}px`} />
      ))}
    </span>
    {url && (
      <a class="ticket__link" href={url} target="_blank" rel="noopener noreferrer">
        {labels.view} ↗
      </a>
    )}
  </div>
</article>
