---
import './Contact.scss';
import QRCode from 'qrcode';
import LiveClock from '@/components/ui/LiveClock/LiveClock.astro';
import type { Dictionary } from '@/i18n';

interface Props {
  t: Dictionary['contact'];
  hud: Dictionary['hud'];
}

const { t, hud } = Astro.props;
// El correo nunca aparece completo en el HTML (lo recolectarían bots): el "@" lo pinta
// el CSS y el script arma la dirección al copiar.
const [EMAIL_USER, EMAIL_DOMAIN] = ['jaiver.navia', 'gmail.com'];
const LINKEDIN = 'https://www.linkedin.com/in/jaiberflor';

// QR generado en build; el trazo hereda el color del texto (currentcolor).
const qr = (
  await QRCode.toString(LINKEDIN, {
    type: 'svg',
    margin: 0,
    color: { dark: '#000000', light: '#ffffff00' },
  })
)
  .replace('stroke="#000000"', 'stroke="currentColor"')
  .replace('<svg ', '<svg aria-hidden="true" ');
---

<contact-section class="contact" id="contact">
  <section class="contact__inner" aria-labelledby="contact-title">
    <p class="contact__eyebrow" data-reveal>
      {t.eyebrow}
    </p>
    <h2 class="contact__title" id="contact-title" data-split data-fit>
      {t.title}
    </h2>

    <div class="contact__grid">
      <button
        class="contact__cell contact__email"
        type="button"
        data-copy-email
        data-email-user={EMAIL_USER}
        data-email-domain={EMAIL_DOMAIN}
        data-copied-label={t.emailCopied}
      >
        <span class="contact__hint">{t.copyEmail} ⧉</span>
        <span class="contact__address" data-copy-label>
          {EMAIL_USER}
          <span class="contact__at"></span>
          {EMAIL_DOMAIN}
        </span>
      </button>

      <a
        class="contact__cell contact__linkedin"
        href={LINKEDIN}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact__hint">linkedin.com/in/jaiberflor</span>
        <span class="contact__big">LinkedIn ↗</span>
      </a>

      <div class="contact__cell contact__qr">
        <Fragment set:html={qr} />
        <span class="contact__hint">{t.qrLabel}</span>
      </div>

      <div class="contact__cell contact__where">
        <span class="contact__hint">
          {hud.location} · {hud.coordinates}
        </span>
        <LiveClock label={hud.localTime} />
        <p class="contact__lead">{t.lead}</p>
      </div>
    </div>

    <p class="visually-hidden" role="status" data-copy-status></p>
  </section>
</contact-section>

<script>
  import './Contact.ts';
</script>
