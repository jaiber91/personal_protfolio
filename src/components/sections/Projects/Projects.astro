---
import './Projects.scss';
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/ui/ProjectCard/ProjectCard.astro';
import type { Dictionary, Locale } from '@/i18n';

interface Props {
  locale: Locale;
  t: Dictionary['projects'];
}

const { locale, t } = Astro.props;
const projects = (await getCollection('projects', ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<!-- Proyectos como pases de abordar. En escritorio la sección se fija y el scroll
     los desplaza de lado; en móvil van en columna. -->
<projects-section class="projects" id="projects">
  <section class="projects__pin" aria-labelledby="projects-title" data-projects-pin>
    <header class="projects__header container">
      <p class="projects__eyebrow" data-reveal>
        {t.eyebrow}
      </p>
      <h2 class="projects__title" id="projects-title" data-split>
        {t.title}
      </h2>
    </header>

    {projects.length > 0 ? (
      <ol class="projects__track" role="list" data-projects-track>
        {projects.map((project, index) => (
          <li class="projects__slide" data-projects-slide>
            <ProjectCard
              index={index + 1}
              total={projects.length}
              {...project.data}
              labels={{
                pass: t.pass,
                gate: t.gateLabel,
                year: t.yearLabel,
                role: t.roleLabel,
                stack: t.stackLabel,
                view: t.viewLabel,
              }}
            />
          </li>
        ))}
      </ol>
    ) : (
      <p class="projects__empty container">{t.empty}</p>
    )}
  </section>
</projects-section>

<script>
  import './Projects.ts';
</script>
