---
import './Projects.scss';
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/ui/ProjectCard/ProjectCard.astro';
import SectionHeading from '@/components/ui/SectionHeading/SectionHeading.astro';
import type { Dictionary, Locale } from '@/i18n';

interface Props {
  locale: Locale;
  t: Dictionary['projects'];
}

const { locale, t } = Astro.props;
const projects = (await getCollection('projects', ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<projects-section class="projects" id="projects">
  <!-- Igual que en Platforms: se fija este div, no el custom element. -->
  <section class="projects__pin" aria-labelledby="projects-title" data-projects-pin>
    <div class="projects__header container">
      <SectionHeading eyebrow={t.eyebrow} title={t.title} id="projects-title" />
      <span class="projects__progress" aria-hidden="true">
        <span class="projects__progress-bar" data-projects-progress></span>
      </span>
    </div>
    {projects.length > 0 ? (
      <ol class="projects__track" role="list" data-projects-track>
        {projects.map((project, index) => (
          <li class="projects__slide" data-projects-slide>
            <ProjectCard
              index={index + 1}
              total={projects.length}
              {...project.data}
              labels={{ role: t.roleLabel, stack: t.stackLabel, view: t.viewLabel }}
            />
          </li>
        ))}
      </ol>
    ) : (
      <p class="projects__empty container">{t.empty}</p>
    )}
  </section>
</projects-section>

<script>
  import './Projects.ts';
</script>
