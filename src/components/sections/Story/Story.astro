---
import './Story.scss';
import { LOCALE_META, type Dictionary, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  t: Dictionary['story'];
}

const { locale, t } = Astro.props;
const numberFormat = new Intl.NumberFormat(LOCALE_META[locale].htmlLang, { useGrouping: 'always' });
const { board } = t;
---

{/* Trayectoria como tablero de salidas: cada empresa es un vuelo (letras split-flap).
     Al abrir un vuelo se ven sus cifras y logros. */}
<story-section class="story" id="story">
  <div class="story__inner container">
    <header class="story__header">
      <p class="story__eyebrow" data-reveal>
        {t.eyebrow}
      </p>
      <h2 class="story__title" data-split>
        {t.title}
      </h2>
    </header>

    <div class="story__board" data-story-board>
      <div class="story__board-top">
        <p class="story__board-title">
          <span>✈ {board.title}</span>
          <span class="story__board-subtitle">{board.subtitle}</span>
        </p>
        <p class="story__hint">
          <span class="story__hint-arrow" aria-hidden="true">
            ↓
          </span>
          {board.hint}
        </p>
      </div>

      <div class="story__head" aria-hidden="true">
        <span>{board.columns.period}</span>
        <span>{board.columns.company}</span>
        <span class="story__head-role">{board.columns.role}</span>
        <span>{board.columns.status}</span>
      </div>

      {t.items.map((item, index) => (
        <article class="story__flight" data-flight data-open={index === 0 ? '' : undefined}>
          <h3 class="story__flight-heading">
            <button
              class="story__row"
              type="button"
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`flight-${index}`}
              data-flight-toggle
            >
              <span class="story__cell story__cell--period" data-flap>
                {item.period}
              </span>
              <span class="story__cell story__cell--company" data-flap>
                {item.company}
              </span>
              <span class="story__cell story__cell--role" data-flap>
                {item.role}
              </span>
              <span
                class:list={['story__cell story__cell--status', { 'is-current': item.current }]}
                data-flap
              >
                {item.current ? board.status.current : board.status.done}
              </span>
              <span class="story__toggle" aria-hidden="true">
                <span class="story__toggle-open">{board.details} +</span>
                <span class="story__toggle-close">{board.close} ×</span>
              </span>
            </button>
          </h3>

          <div class="story__panel" id={`flight-${index}`} data-flight-panel>
            <div class="story__panel-inner">
              <p class="story__panel-role">{item.role}</p>
              <dl class="story__metrics" aria-label={t.metricsLabel}>
                {item.metrics.map((metric) => (
                  <div class="story__metric">
                    <dt class="story__label">
                      <span class="story__label-title">{metric.label}</span>
                      <span class="story__detail">{metric.detail}</span>
                    </dt>
                    <dd
                      class="story__value"
                      data-count={metric.value}
                      data-count-from={
                        'from' in metric && metric.from !== undefined ? metric.from : 0
                      }
                      data-count-suffix={metric.suffix}
                    >
                      {numberFormat.format(metric.value)}
                      {metric.suffix}
                    </dd>
                  </div>
                ))}
              </dl>
              <ul class="story__stack" role="list" aria-label={t.stackLabel}>
                {item.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="story__layovers" aria-labelledby="education-title">
      <h3 class="story__layovers-title" id="education-title">
        {t.educationTitle}
      </h3>
      <ul class="story__courses" role="list">
        {t.education.map((entry) => (
          <li class="story__course" data-reveal>
            <span class="story__course-period">{entry.period}</span>
            <span class="story__course-title">{entry.title}</span>
            <span class="story__course-place">{entry.place}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</story-section>

<script>
  import './Story.ts';
</script>
